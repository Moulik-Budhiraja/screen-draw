{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "screen-utils",
  "title": "Screen Utils",
  "description": "Search the screenshots and drawings saved with Screen Utils",
  "icon": "extension-icon.png",
  "author": "moulik",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search",
      "title": "Search Screenshots",
      "subtitle": "Screen Utils",
      "description": "Search screenshots by note, text, @folder and #tag",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "libraryPath",
      "title": "Library Folder",
      "description": "Where Screen Utils saves screenshots",
      "type": "textfield",
      "default": "~/Pictures/Screen Utils",
      "required": false
    }
  ],
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  },
  "dependencies": {
    "@raycast/api": "^1.103.0",
    "@raycast/utils": "^2.2.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
